[0.157, "o", "Поиск\r\nPOST /search {\"query\": \"саксофон лаконичный\"}\r\nHTTP 200\r\n{\r\n  \"status\": \"ok\",\r\n  \"model\": \"improved\",\r\n  \"results\": [\r\n    {\r\n      \"id\": \"P001\",\r\n      \"genre\": \"джаз\",\r\n      \"style\": \"минимализм\",\r\n      \"score\": 0.901752,\r\n      \"source\": \"generated:demo/project.py\",\r\n      \"rights_status\": \"demo_allowed\",\r\n      \"image\": \"demo/data/posters/P001.svg\"\r\n    },\r\n    {\r\n      \"id\": \"P003\",\r\n      \"genre\": \"джаз\",\r\n      \"style\": \"минимализм\",\r\n      \"score\": 0.901752,\r\n      \"source\": \"generated:demo/project.py\",\r\n      \"rights_status\": \"demo_allowed\",\r\n      \"image\": \"demo/data/posters/P003.svg\"\r\n    },\r\n    {\r\n      \"id\": \"P005\",\r\n      \"genre\": \"джаз\",\r\n      \"style\": \"минимализм\",\r\n      \"score\": 0.901752,\r\n      \"source\": \"generated:demo/project.py\",\r\n      \"rights_status\": \"demo_allowed\",\r\n      \"image\": \"demo/data/posters/P005.svg\"\r\n    }\r\n  ],\r\n  \"human_decision_required\": true\r\n}\r\n\r\n"]
[0.188, "o", "Выбор\r\nPOST /feedback {\"record_id\": \"P001\", \"action\": \"select\", \"actor\": \"designer_demo\"}\r\nHTTP 200\r\n{\r\n  \"record_id\": \"P001\",\r\n  \"action\": \"select\",\r\n  \"actor\": \"designer_demo\",\r\n  \"proposed_style\": null,\r\n  \"status\": \"recorded\",\r\n  \"model_updated\": false\r\n}\r\n\r\n"]
[0.188, "o", "Пустой запрос\r\nPOST /search {\"query\": \"\"}\r\nHTTP 400\r\n{\r\n  \"status\": \"error\",\r\n  \"error\": \"empty_query\"\r\n}\r\n\r\n"]
[0.203, "o", "Другой язык\r\nPOST /search {\"query\": \"jazz minimalist\"}\r\nHTTP 200\r\n{\r\n  \"status\": \"no_matches\",\r\n  \"model\": \"improved\",\r\n  \"results\": [],\r\n  \"human_decision_required\": true\r\n}\r\n\r\n"]
[0.203, "o", "Резервный режим\r\nPOST /search {\"query\": \"джаз минимализм\"}\r\nHTTP 200\r\n{\r\n  \"status\": \"fallback\",\r\n  \"model\": \"baseline\",\r\n  \"results\": [\r\n    {\r\n      \"id\": \"P001\",\r\n      \"genre\": \"джаз\",\r\n      \"style\": \"минимализм\",\r\n      \"score\": 0.901752,\r\n      \"source\": \"generated:demo/project.py\",\r\n      \"rights_status\": \"demo_allowed\",\r\n      \"image\": \"demo/data/posters/P001.svg\"\r\n    },\r\n    {\r\n      \"id\": \"P003\",\r\n      \"genre\": \"джаз\",\r\n      \"style\": \"минимализм\",\r\n      \"score\": 0.901752,\r\n      \"source\": \"generated:demo/project.py\",\r\n      \"rights_status\": \"demo_allowed\",\r\n      \"image\": \"demo/data/posters/P003.svg\"\r\n    },\r\n    {\r\n      \"id\": \"P005\",\r\n      \"genre\": \"джаз\",\r\n      \"style\": \"минимализм\",\r\n      \"score\": 0.901752,\r\n      \"source\": \"generated:demo/project.py\",\r\n      \"rights_status\": \"demo_allowed\",\r\n      \"image\": \"demo/data/posters/P005.svg\"\r\n    }\r\n  ],\r\n  \"human_decision_required\": true\r\n}\r\n\r\n"]
